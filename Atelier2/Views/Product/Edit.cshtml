@model Atelier2.ViewModels.EditViewModel

@{
    ViewData["Title"] = "Modifier le Produit";
    var photoPath = "~/images/" + (Model.ExistingImagePath ?? "noimage.jpg");
}

<h1>Modifier le Produit</h1>
<h4>Product</h4>
<hr />

<form asp-controller="Product" asp-action="Edit" enctype="multipart/form-data" method="post" class="mt-3">
    <div asp-validation-summary="All" class="text-danger"></div>

    <input hidden asp-for="ProductId" />
    <input hidden asp-for="ExistingImagePath" />

    <div class="form-group mb-3">
        <label asp-for="Name" class="control-label">Nom du produit</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Price" class="control-label">Prix</label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="QteStock" class="control-label">Quantité en stock</label>
        <input asp-for="QteStock" class="form-control" />
        <span asp-validation-for="QteStock" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="CategoryId" class="control-label">Catégorie</label>
        <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.CategoryId"></select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="ImagePath" class="control-label">Changer l'image</label>
        <div class="custom-file">
            <input asp-for="ImagePath" class="form-control custom-file-input" id="imageInput" />
        </div>
    </div>

    <div class="form-group mb-3 text-center">
        <img id="imageEmp" src="@photoPath" class="img-thumbnail" style="height: 150px; width: auto;" asp-append-version="true" />
    </div>

    <div class="form-group mt-3">
        <button type="submit" class="btn btn-primary">Mettre à jour</button>
        <a asp-action="Index" asp-controller="Product" class="btn btn-secondary">Annuler</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            $('.custom-file-input').on("change", function () {
                var fileName = $(this).val().split("\\").pop();
                $(this).next('.custom-file-label').html(fileName);

                // Prévisualisation en direct de l'image sélectionnée
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#imageEmp').attr('src', e.target.result);
                };
                reader.readAsDataURL(this.files[0]);
            });
        });
    </script>
}