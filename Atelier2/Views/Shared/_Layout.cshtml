@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Atelier2</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
            .custom-navbar {
                background-color: #58b19f !important;
            }

            .btn-view {
                background-color: #7bdcb5 !important;
                color: white !important;
            }

            .btn-edit {
                background-color: #5edfff !important;
                color: white !important;
            }

            .btn-delete {
                background-color: #ff7b54 !important;
                color: white !important;
            }

            .search-btn {
                background-color: #ff9f80 !important;
                border: none !important;
                color: white !important;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark custom-navbar mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-white" asp-area="" asp-controller="Product" asp-action="Index">Gestion des Articles</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        <!-- Lien Administration pour accéder aux rôles -->
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Admin" asp-action="ListRoles">Administration</a>
                        </li>

                        <!-- Menu Déroulant Liste d'articles -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Liste d'articles
                            </a>
                            <ul class="dropdown-menu bg-dark" aria-labelledby="navbarDropdown">
                                <li><a class="dropdown-item text-white" asp-controller="Product" asp-action="Index">Tous les articles</a></li>
                                <li><a class="dropdown-item text-white" asp-controller="Product" asp-action="Create">Nouvel Article</a></li>
                            </ul>
                        </li>
                    </ul>

                    <!-- Barre de Recherche -->
                    <form class="d-flex me-3" asp-controller="Product" asp-action="Search" method="get">
                        <input class="form-control me-2 bg-dark text-white border-secondary" type="search" name="val" placeholder="Search">
                        <button class="btn search-btn" type="submit">Search</button>
                    </form>

                    <!-- Liens d'Authentification (Register / Login / Logout) -->
                    <ul class="navbar-nav">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <form method="post" asp-controller="Account" asp-action="Logout">
                                    <button type="submit" class="nav-link btn btn-link text-white py-0" style="width:auto">
                                        Logout @User.Identity?.Name
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/CustomScript.js"></script>
    @await RenderSectionAsync("Scripts", required: false)


    @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
    {
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" ariahaspopup="true" aria-expanded="false">Administration</a>
            <div class="dropdown-menu">
                <a class="dropdown-item" asp-area="" asp-controller="Admin" asp-action="CreateRole">
                    Create
                    Role
                </a>
                <div class="dropdown-divider"></div>
                <a class="dropdown-item" asp-area="" asp-controller="Admin" asp-action="ListRoles">
                    List
                    Roles
                </a>
            </div>
        </li>
    }
</body>
</html>