<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gestion des Articles</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            .custom-navbar {
                background-color: #58b19f !important;
            }

            .search-btn {
                background-color: #ff9f80 !important;
                border-color: #ff9f80 !important;
                color: white !important;
            }

            .search-input {
                background-color: #2b2b2b !important;
                color: white !important;
                border: none !important;
            }

                .search-input::placeholder {
                    color: #aaa !important;
                }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark custom-navbar mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-white" asp-area="" asp-controller="Product" asp-action="Index">Gestion des Articles</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarColor01" aria-controls="navbarColor01"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarColor01">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        @* Menu déroulant "Liste d'articles" *@
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" data-bs-toggle="dropdown" href="#"
                               role="button" aria-haspopup="true" aria-expanded="false">Liste d'articles</a>
                            <ul class="dropdown-menu bg-dark">
                                <li><a class="dropdown-item text-white" asp-controller="Product" asp-action="Index">Tous les articles</a></li>
                                <li><a class="dropdown-item text-white" asp-controller="Product" asp-action="Create">Nouvel Article</a></li>
                            </ul>
                        </li>
                    </ul>

                    @* Formulaire de recherche *@
                    <form class="d-flex" asp-controller="Product" asp-action="Search" method="get">
                        <input class="form-control me-2 search-input" type="search" placeholder="Search" name="val">
                        <button class="btn search-btn" type="submit">Search</button>
                    </form>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted text-center py-3">
        <div class="container">
            &copy; 2026 - Gestion des Articles
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>